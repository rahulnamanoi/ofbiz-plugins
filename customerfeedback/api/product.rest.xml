<api name="CustomerFeedbackProductApi"
     displayName="Customer Feedback Product API"
     path="customerfeedback"
     description="REST endpoints for product lookups used by the customer feedback component."
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/rest-api.xsd">

    <resource name="CustomerFeedbackProductResource"
              path="products"
              displayName="Customer Feedback Product Resource"
              description="Provides product data for feedback workflows."
              auth="false">

        <operation verb="get" path="{idToFind}" description="Fetch product details by ID" auth="false"
                   produces="application/json">
            <service name="findProductById"/>
        </operation>
    </resource>
</api>
