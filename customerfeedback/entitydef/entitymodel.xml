<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Customer Feedback Entity Model</title>
    <description>Entities for capturing customer feedback.</description>
    <version>1.0</version>
    <default-resource-name>CustomerFeedbackEntityLabels</default-resource-name>

    <entity entity-name="CustomerFeedback" package-name="org.apache.ofbiz.customerfeedback"
            title="Customer Feedback">
        <field name="feedbackId" type="id">
            <description>Primary identifier for the feedback entry.</description>
        </field>
        <field name="productId" type="id">
            <description>Associated product identifier.</description>
        </field>
        <field name="customerId" type="id">
            <description>Party identifier of the customer leaving the feedback.</description>
        </field>
        <field name="rating" type="floating-point">
            <description>Numeric rating provided by the customer.</description>
        </field>
        <field name="comments" type="very-long">
            <description>Free form comments from the customer.</description>
        </field>
        <field name="createdDate" type="date-time">
            <description>Timestamp when the feedback was created.</description>
        </field>
        <prim-key field="feedbackId"/>
        <relation type="one" fk-name="CUSTFEED_PROD" rel-entity-name="Product">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="CUSTFEED_CUST" rel-entity-name="Party">
            <key-map field-name="customerId" rel-field-name="partyId"/>
        </relation>
    </entity>
</entitymodel>
