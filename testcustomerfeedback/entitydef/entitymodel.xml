<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Test Customer Feedback Entity Model</title>
    <description>Entities used by the testcustomerfeedback component.</description>
    <version>1.0</version>
    <default-resource-name>TestCustomerFeedbackEntityLabels</default-resource-name>

    <entity entity-name="CustomerProductFeedback" package-name="org.apache.ofbiz.testcustomerfeedback"
            title="Customer Product Feedback">
        <field name="customerProductFeedbackId" type="id">
            <description>Primary identifier for the feedback entry.</description>
        </field>
        <field name="productId" type="id">
            <description>Identifier of the product receiving feedback.</description>
        </field>
        <field name="partyId" type="id">
            <description>Party identifier of the submitting customer.</description>
        </field>
        <field name="rating" type="floating-point">
            <description>Rating value supplied with the feedback.</description>
        </field>
        <field name="comments" type="very-long"/>
        <field name="createdDate" type="date-time"/>
        <prim-key field="customerProductFeedbackId"/>
        <relation type="one" fk-name="CUSTPRODFB_PROD" rel-entity-name="Product">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="CUSTPRODFB_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId" rel-field-name="partyId"/>
        </relation>
    </entity>
</entitymodel>
