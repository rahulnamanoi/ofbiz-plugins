<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>MultiTenant Database Services</description>

    <!-- Execute Database Creation Script -->
    <service name="executeDbCreationScript" engine="java"
             location="org.apache.ofbiz.multitenant.service.DatabaseService" invoke="executeDbCreationScript" auth="true">
        <description>Execute Database Creation Script</description>
        <attribute name="dbName" type="String" mode="IN" optional="false"/>
        <attribute name="dbUser" type="String" mode="IN" optional="true" default-value="postgres"/>
        <attribute name="dbHost" type="String" mode="IN" optional="true" default-value="localhost"/>
        <attribute name="dbPort" type="String" mode="IN" optional="true" default-value="5432"/>
        <attribute name="dbPassword" type="String" mode="IN" optional="true"/>
        <attribute name="result" type="String" mode="OUT" optional="true"/>
        <attribute name="output" type="String" mode="OUT" optional="true"/>
        <attribute name="errorMessage" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- Check if Database Exists -->
    <service name="checkDatabaseExists" engine="java"
             location="org.apache.ofbiz.multitenant.service.DatabaseService" invoke="checkDatabaseExists" auth="true">
        <description>Check if PostgreSQL Database Exists</description>
        <attribute name="dbName" type="String" mode="IN" optional="false"/>
        <attribute name="dbHost" type="String" mode="IN" optional="true" default-value="localhost"/>
        <attribute name="dbPort" type="String" mode="IN" optional="true" default-value="5432"/>
        <attribute name="dbUser" type="String" mode="IN" optional="true" default-value="postgres"/>
        <attribute name="dbPassword" type="String" mode="IN" optional="true"/>
        <attribute name="exists" type="Boolean" mode="OUT" optional="false"/>
        <attribute name="status" type="String" mode="OUT" optional="false"/>
        <attribute name="message" type="String" mode="OUT" optional="true"/>
        <attribute name="dbHost" type="String" mode="OUT" optional="true"/>
        <attribute name="dbPort" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- Get Database Status for UI Display -->
    <service name="getDatabaseStatus" engine="java"
             location="org.apache.ofbiz.multitenant.service.DatabaseService" invoke="getDatabaseStatus" auth="true">
        <description>Get Database Status for UI Display</description>
        <attribute name="tenantId" type="String" mode="IN" optional="false"/>
        <attribute name="dbName" type="String" mode="IN" optional="false"/>
        <attribute name="dbHost" type="String" mode="IN" optional="true" default-value="localhost"/>
        <attribute name="dbPort" type="String" mode="IN" optional="true" default-value="5432"/>
        <attribute name="dbUser" type="String" mode="IN" optional="true" default-value="postgres"/>
        <attribute name="dbPassword" type="String" mode="IN" optional="true"/>
        <attribute name="status" type="String" mode="OUT" optional="false"/>
        <attribute name="statusDisplay" type="String" mode="OUT" optional="false"/>
        <attribute name="statusClass" type="String" mode="OUT" optional="false"/>
        <attribute name="exists" type="Boolean" mode="OUT" optional="false"/>
        <attribute name="dbName" type="String" mode="OUT" optional="true"/>
        <attribute name="dbHost" type="String" mode="OUT" optional="true"/>
        <attribute name="dbPort" type="String" mode="OUT" optional="true"/>
    </service>
</services>