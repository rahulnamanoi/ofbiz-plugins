<screens xmlns="http://ofbiz.apache.org/Widget-Screen"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://ofbiz.apache.org/Widget-Screen https://ofbiz.apache.org/dtds/widget-screen.xsd">

    <screen name="CreateUserForm">
        <section>
            <actions>
                <set field="title" value="Create User"/>
            </actions>
            <widgets>
                <container>
                    <label text="${requestAttributes._ERROR_MESSAGE_}" style="h4 text-danger"/>
                    <label text="${requestAttributes._EVENT_MESSAGE_}" style="h4 text-success"/>
                    <form name="CreateUser" type="single" target="createUserSubmit" method="post">
                        <field name="firstName" title="First Name">
                            <text size="40" required="true"/>
                        </field>
                        <field name="lastName" title="Last Name">
                            <text size="40" required="true"/>
                        </field>
                        <field name="email" title="Email">
                            <text size="40" required="true"/>
                        </field>
                        <field name="username" title="Username">
                            <text size="40" required="true"/>
                        </field>
                        <field name="password" title="Password">
                            <password required="true"/>
                        </field>
                        <field name="submit" title="">
                            <submit button-text="Create User"/>
                        </field>
                    </form>
                </container>
            </widgets>
        </section>
    </screen>

    <screen name="CreateUserSuccess">
        <section>
            <widgets>
                <container>
                    <label text="${parameters.successMessage}" style="h3 text-success"/>
                    <link target="createUser" text="Create another user"/>
                </container>
            </widgets>
        </section>
    </screen>
</screens>
